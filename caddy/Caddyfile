{$DOMAIN} {
	# Access log of dashboard visits. The file sits in the caddy_data volume
	# (no compose change). The history is kept for years: Caddy's default
	# roll_keep_for is 90 days, so it is set explicitly. Rolled files are
	# gzipped; 100 of them cap the log at ~1 GB uncompressed.
	log {
		output file /data/access.log {
			roll_size 10MiB
			roll_keep 100
			roll_keep_for 3650d
		}
		format json
	}

	# The api keeps its two routes; everything else (including websockets,
	# which reverse_proxy upgrades automatically) goes to the dashboard.
	handle /sensor* {
		# The ESP32 posts every few seconds: noise, not visits.
		log_skip
		reverse_proxy api:8000
	}
	handle /table {
		log_skip
		reverse_proxy api:8000
	}
	handle {
		reverse_proxy dashboard:8501
	}
}
