# Copy to .env and fill in real values. .env is gitignored — this file is
# the documented list of every knob the stack needs.

# Public hostname Caddy serves. "localhost" for local runs (self-signed cert);
# a real domain on the VPS (automatic Let's Encrypt).
DOMAIN=localhost

# Postgres superuser credentials (used by the api service).
POSTGRES_USER=weather
POSTGRES_PASSWORD=changeme
POSTGRES_DB=weather

# Shared secret the ESP32 sends as "Authorization: Bearer <token>".
# Generate with: openssl rand -hex 32
SENSOR_TOKEN=changeme
