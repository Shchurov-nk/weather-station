# Copy to .env and fill in real values. .env is gitignored — this file is
# the documented list of every knob the stack needs.

# Public hostname Caddy serves. "localhost" for local runs (self-signed cert);
# a real domain on the VPS (automatic Let's Encrypt).
DOMAIN=localhost

# Which api image tag to run. Leave empty for "latest" (what CI publishes on
# every push to main); set to sha-<short> to pin/roll back to an older build.
API_TAG=

# Same for the dashboard image.
DASHBOARD_TAG=

# Postgres superuser credentials (used by the api service).
POSTGRES_USER=weather
POSTGRES_PASSWORD=changeme
POSTGRES_DB=weather

# Shared secret the ESP32 sends as "Authorization: Bearer <token>".
# Generate with: openssl rand -hex 32
SENSOR_TOKEN=changeme

# Password of the read-only ws_reader role the dashboard connects as.
# scripts/ensure_reader_role.sh (run by every deploy) resets the role's
# password to this value. "reader" is fine locally; a real one on the VPS.
READER_PASSWORD=reader

# Timezone charts are displayed in (reading_time is stored in UTC).
DASHBOARD_TZ=Europe/Moscow
